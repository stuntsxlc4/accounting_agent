# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repo.

# Środowisko KSeF: test | demo | prod
KSEF_ENV=test

# NIP firmy (bez kresek)
KSEF_NIP=

# Certyfikat KSeF typu "uwierzytelnienie" (z Modułu Certyfikatów i Uprawnień)
KSEF_CERT_PATH=
KSEF_KEY_PATH=
KSEF_KEY_PASSWORD=

# Folder, do którego zapisywane są faktury
OUTPUT_DIR=
